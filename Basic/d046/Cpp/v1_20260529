#include <bits/stdc++.h>
using namespace std;

int main() {
    
    //輸入
    int n;
    cin>>n;
    vector<int> lst(n);
    for(int i=0;i<n;i++){
        cin>>lst[i];
    }
    
    //初始化
    int ans=0;
    
    for(int i=0;i<n;i++){
        if(lst[i]<=10){ans++;}
    }
    
    //輸出
    cout<<ans;
}

#include <bits/stdc++.h>
using namespace std;

int main() {
    int cas=0;
    int n;
    while(cin>>n){
        cas++;
        vector<int> lst(n);
        for(int i=0;i<n;i++){
            cin>>lst[i];
        }
        
        //初始化
        long long int ans=0;
        bool x=true;
        
        for(int i=0;i<n;i++){
            long long int current_ans=1;
            for(int j=i;j<n;j++){
                current_ans*=lst[j];
                if(current_ans>ans){ans=current_ans;}
            }
        }
        
        //輸出
        cout<<"Case #"<<cas<<": The maximum product is "<<ans<<".\n\n";
    }
}
